DATABASE_URL=
DASHBOARD_PORT=3000
JWT_SECRET=
PROXY=
OCR_APIKEY=

# DB_PROVIDER controls which database adapter is used.
# Options: mongodb (default) | postgres | sqlite | json
# - mongodb : requires DATABASE_URL=mongodb://... and prisma/schema.prisma (current)
# - postgres: requires DATABASE_URL=postgresql://... and prisma/schema.postgres.prisma
# - sqlite  : requires DATABASE_URL=file:./data/chisato.db and prisma/schema.sqlite.prisma
# - json    : no database server needed; data stored in data/*.json files
DB_PROVIDER=mongodb

# Optional Redis cache. If set, Redis is used instead of the in-memory cache.
# Requires: npm install ioredis
# REDIS_URL=redis://localhost:6379
